APP_ENV=sandbox
RUN_LIVE_SANDBOX=false
AI_INBOUND_ENABLED=true

# Fallback legado temporario. Para multi-tenant, prefira credential_ref por organizacao.
OPENAI_API_KEY=
OPENAI_RESPONSES_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CRM operacional: domínio e credencial de backend separados da IA/RAG.
CRM_SUPABASE_URL=
CRM_SUPABASE_SERVICE_ROLE_KEY=
CRM_AI_MONITORING_ENABLED=false
CRM_ZAPI_INSTANCE_ORGANIZATION_MAP_JSON=

LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ai-atendimento-sandbox

GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_TIMEZONE=America/Bahia
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_REDIRECT_PORT=8765
GOOGLE_OAUTH_TOKEN_FILE=.secrets/google-calendar-sandbox-oauth.json

WHATSAPP_PROVIDER=zapi
# WHATSAPP_PROVIDER=evolution
# WHATSAPP_PROVIDER=meta_cloud

ZAPI_BASE_URL=
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_PUBLIC_WEBHOOK_URL=
ZAPI_ORGANIZATION_ID=sandbox-org-dr-leonardo-carvalho
ZAPI_INSTANCE_ORGANIZATION_MAP_JSON=
ZAPI_STORE_PATH=/var/data/zapi-whatsapp-store.json

ORGANIZATION_RUNTIME_CONFIG_JSON=
ORGANIZATION_CREDENTIALS_JSON=
OPENAI_API_KEY_CARVALHO=
ZAPI_INSTANCE_TOKEN_CARVALHO=

MESSAGE_BATCH_ENABLED=true
MESSAGE_BATCH_DEBOUNCE_MS=6000
MESSAGE_BATCH_MAX_WAIT_MS=12000

AUDIO_INBOUND_ENABLED=true
AUDIO_MAX_BYTES=20971520
AUDIO_DOWNLOAD_TIMEOUT_SECONDS=30
AUDIO_STT_MAX_ATTEMPTS=2

AI_ASSISTANT_NAME=
AI_ASSISTANT_ROLE=
AI_CLINIC_NAME=Clinica Carvalho e Tavares Odontologia Integrada
AI_DOCTOR_NAME=Dr. Leonardo Carvalho
AI_ASSISTANT_TONE=natural, consultivo e objetivo
AI_SALES_GOAL=conduzir o paciente ate o proximo passo adequado
AI_PRIMARY_CONVERSION_ACTION=avaliacao ou consulta
AI_MAX_DISCOVERY_DEPTH=3
AI_CTA_STYLE=natural e sem pressao
AI_APPOINTMENT_FLOW=somente quando contexto de agendamento estiver ativo
AI_BUSINESS_HOURS=segunda a sexta, 8h as 19h; sabado, 8h as 12h
AI_LOCATIONS=Clinica Carvalho - Rua Dr. Otaviano Pimenta, 41, Matatu/Brotas, Salvador/BA|Clinica Tavares - Hospital da Bahia, Bloco A, 4 andar, sala 4020, Av. Prof. Magalhaes Neto, 1541, Pituba, Salvador/BA

EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_PUBLIC_WEBHOOK_URL=
